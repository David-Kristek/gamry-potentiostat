# Machine-specific settings -- copy to .env (gitignored) and fill in what this
# computer needs. Everything is optional: unset values fall back to the
# documented default/auto-detection. A real env var overrides the .env value.

# Path to the Gamry-provided 32-bit Python 3.7 that ToolkitPy is installed
# into. Defaults to the standard Gamry install location when unset:
#   C:\Program Files (x86)\Gamry Instruments\Python\Python37-32\python.exe
GAMRY_PYTHON=

# Only needed if toolkitpy was pip-installed with --target pointing at Gamry's
# own Framework folder instead of that Python's site-packages. Auto-detected
# next to GAMRY_PYTHON when unset.
TOOLKITPY_HOME=

# Points GAMRY_PYTHON's PYTHONPATH at this source checkout so `import
# potentiostat` resolves here instead of a pip-installed copy. Auto-detected
# when unset. Unset once `pip install potentiostat` into GAMRY_PYTHON is in
# place. pydantic<2.6 and pyproc-bridge are handled automatically.
GAMRY_SOURCE_ROOT=
